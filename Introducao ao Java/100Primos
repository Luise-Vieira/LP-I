public class Main {
    public static void main(String[] args) {

        int cont = 0;
        int num = 2;
        int primos = 0;

        while (primos < 100) {
            cont = 0;
            for (int i = 1; i <= num; i++) {
                if (num % i == 0) {
                    cont++;
                }
            }
            if (cont == 2) {
                primos++;
                System.out.println(primos + " - " + num + " é primo");

            }

            num++;

        }
    }
}
